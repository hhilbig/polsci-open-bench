# Python
__pycache__/
*.pyc
*.pyo
.pytest_cache/
.venv/
venv/
*.egg-info/

# macOS
.DS_Store

# Editor
.vscode/
.idea/

# Claude Code local state
.claude/

# Quarto
/.quarto/
*_files/

# LaTeX intermediates from quarto pdf renders (output/report_pdf.qmd)
output/*.aux
output/*.fdb_latexmk
output/*.fls
output/*.synctex.gz
output/*.tex
output/arxiv/

# Internal long-form HTML report (not part of the public release;
# the public deliverable is output/report_pdf.pdf)
output/report.html
output/report.qmd

# Internal benchmark-candidates inventory schema (working notes)
docs/inventory_schema.md

# Launch kit (figures + tweet drafts staged for posting; not part of the repo)
launch/

# Logs / transient outputs
*.log
output/run.log
output/rerun.log

# Local run ledger/status. These files can contain machine paths, process ids,
# API batch ids, and cost notes from private development runs.
output/run_registry.jsonl
docs/run_status.md

# Mid-flight benchmark working dir (overwritten by run scripts)
output/tmp/
.tmp_runtime/

# Development run/import scratch. Public release files live directly under
# output/ and are the benchmark outputs used by the report.
output/sidecar/
output/openai_batch/
output/anthropic_batch/

# Local run wrappers copied to mac2 during one-off runs
scripts/

# Deprecated compatibility manifests
tasks_v2pt2_local/

# Backup files
*.backup
*~

# Personal calendar / iCal files
*.ics

# Private data (single-RA coding, not for redistribution)
data/private/

# Raw source archives. Re-download from upstream sources (CMP/MARPOR,
# H&K replication, Mellon BES, Wesleyan/WMP) when needed; not redistributed
# to keep the repo light.
data/bes_mii_raw/
data/hk2025_raw/
data/wmp2022_raw/

# Historical run archives (intermediate results from earlier rounds)
output/archive/

# Working research scratchbook (not part of the public repo)
quality_reports/
